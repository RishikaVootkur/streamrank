# Postgres user for the MLflow tracking backend
POSTGRES_USER=mlflow
# Postgres password for the MLflow tracking backend (set a random value locally)
POSTGRES_PASSWORD=change-me
# Postgres database name used by MLflow
POSTGRES_DB=mlflow
# Host port for Postgres
POSTGRES_PORT=5432
# Grafana admin user name
GRAFANA_ADMIN_USER=admin
# Grafana admin password (set a random value locally)
GRAFANA_ADMIN_PASSWORD=change-me
# Host port for the recommendation API
API_PORT=8000
# Host port for the MLflow UI (5000 is taken by AirPlay on macOS)
MLFLOW_PORT=5001
# Host port for Grafana
GRAFANA_PORT=3000
# Host port for Prometheus
PROMETHEUS_PORT=9090
# Host port for Redis (Feast online store)
REDIS_PORT=6379
# Host port for the Redpanda Kafka API
REDPANDA_KAFKA_PORT=19092
# Host port for Redpanda Console
REDPANDA_CONSOLE_PORT=8080
# Host port for the Streamlit demo UI
DEMO_UI_PORT=8501
# Redis address for the Feast online store (host:port)
REDIS_CONNECTION_STRING=localhost:6379
# MLflow tracking server address used by training jobs
MLFLOW_TRACKING_URI=http://localhost:5001
# Redpanda (Kafka API) address for the event replay and the streaming job
KAFKA_BROKER=localhost:19092
